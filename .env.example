# ===================================================================
# VARIABLES DE ENTORNO - STACK DOCKER
# ===================================================================

# -------------------------------------------------------------------
# Decisiones base del stack local
# -------------------------------------------------------------------

# Frontend publicado al host. Por defecto queda cerrado a la maquina local.
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=8080

# MySQL
# Por defecto queda interno al stack y no se publica al host.
# Para acceder desde VS Code, levantar con docker-compose.db-access.yml.
MYSQL_HOST=127.0.0.1
MYSQL_HOST_PORT=3307
MYSQL_DATABASE=eventosbd
MYSQL_ROOT_PASSWORD=root

# -------------------------------------------------------------------
# Backend - perfil docker
# -------------------------------------------------------------------

SPRING_PROFILES_ACTIVE=docker
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/eventosbd?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=UTC&useTimezone=false
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root
DB_WAIT_TIMEOUT_SECONDS=120

MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_FROM=noreply@gestion-eventos.local
MAIL_MOCK_MODE=false
MAIL_FAIL_ON_ERROR=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS_ENABLE=false

APP_CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
# Debe coincidir con FRONTEND_HOST:FRONTEND_PORT.
APP_PUBLIC_BASE_URL=http://127.0.0.1:8080

# Obligatorio. Clave de firma de los tokens: generá una propia con `openssl rand -hex 32`.
# El backend no arranca si falta, si tiene menos de 32 bytes o si es la clave que publicaba este archivo.
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# -------------------------------------------------------------------
# Frontend - navegador / Vite
# -------------------------------------------------------------------

# Vacio usa rutas relativas y el proxy interno de Nginx.
VITE_API_BASE_URL=
